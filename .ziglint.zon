.{
    // src/tables.zig is generated by tools/gen.zig from the Unicode Character
    // Database, so it is exempt from the house rules. `zig fmt` still checks
    // it; the generator writes already-formatted source.
    .paths = .{
        "build.zig",
        "src/root.zig",
        "src/unicode.zig",
        "tools/gen.zig",
    },
    .rules = .{
        .Z024 = .{ .max_length = 100 },
    },
}
